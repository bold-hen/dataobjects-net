<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BitFaster.Caching" Version="2.3.3" />
      <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.0" />
      <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Orm\Xtensive.Orm.SqlServer\Xtensive.Orm.SqlServer.csproj" />
      <ProjectReference Include="..\Orm\Xtensive.Orm\Xtensive.Orm.csproj" />
    </ItemGroup>

    <PropertyGroup>
      <XtensiveOrmWeaver>$(SolutionDir)_Build\bin\$(Configuration)\tools\weaver\$(TargetFramework)\Xtensive.Orm.Weaver.dll</XtensiveOrmWeaver>
    </PropertyGroup>
    <Import Project="..\MSBuild\DataObjects.Net.targets" />

</Project>
